---
import Layout from "./layout.astro"
import Markdown from "./markdown.astro"

import "../style.css"

interface TocEntry {
    title: string
    slug: string
    depth: number
}

interface Document {
    slug: string
    title: string
    html: string
    toc: TocEntry[]
}

interface Props {
    documents: Document[]
    currentSlug: string
    document: Document
    basePath: string
    navTitle?: string
}

const {
    documents,
    currentSlug,
    document,
    basePath,
    navTitle
} = Astro.props
---

<Layout>
    <Fragment slot="head">
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism-tomorrow.min.css"
        >
    </Fragment>

    <Fragment slot="body">
        <slot />

        <div class="docs-shell">

            <aside class="docs-sidebar">

                <h2
                    style={`margin-top: 0.4rem; display: ${
                        navTitle ? "flex" : "none"
                    }`}
                >
                    {navTitle}
                </h2>

                <nav class="docs-navigation">

                    {documents.map((item) => (
                        <div
                            class="docs-entry"
                            data-document={item.slug}
                        >
                            <a
                                href={`${basePath}/${item.slug}`}
                                class:list={{
                                    active: item.slug === currentSlug
                                }}
                            >
                                {item.title}
                            </a>

                            {item.toc.length > 0 && (
                                <nav class="docs-entry-toc">
                                    {item.toc.map((entry) => (
                                        <a
                                            href={`${basePath}/${item.slug}#${entry.slug}`}
                                            style={`--depth: ${entry.depth}`}
                                            data-toc-slug={entry.slug}
                                        >
                                            {entry.title}
                                        </a>
                                    ))}
                                </nav>
                            )}
                        </div>
                    ))}

                </nav>

            </aside>

            <main class="docs-content">

                <div class="docs-content__inner">

                    <article class="markdown" data-current-slug={currentSlug}>

                        <h1>{document.title}</h1>

                        <Fragment set:html={document.html} />

                    </article>

                </div>

            </main>

        </div>

        <script>
            import Prism from "prismjs"
            import "prismjs/components/prism-lua"

            Prism.languages.insertBefore("lua", "keyword", {
                const: {
                    pattern: /\bconst\b/,
                    alias: "keyword"
                },
                export: {
                    pattern: /\bexport\b/,
                    alias: "keyword"
                },
                type: {
                    pattern: /\btype\b/,
                    alias: "keyword"
                }
            })

            document
                .querySelectorAll("code.language-lua")
                .forEach((element) => {
                    Prism.highlightElement(element)
                })
        </script>

        <script>
            const article = document.querySelector<HTMLElement>(".markdown")
            const currentSlug = article?.dataset.currentSlug

            if (!currentSlug) {
                throw new Error("Could not determine current document slug")
            }

            const tocLinks = Array.from(
                document.querySelectorAll<HTMLAnchorElement>(
                    `.docs-entry[data-document="${CSS.escape(currentSlug)}"] [data-toc-slug]`
                )
            )

            const headings = Array.from(
                article?.querySelectorAll<HTMLElement>(
                    "h2, h3, h4, h5, h6"
                ) ?? []
            )

            const updateActiveToc = () => {
                const offset =
                    parseFloat(
                        getComputedStyle(document.documentElement)
                            .getPropertyValue("--scroll-offset")
                    ) || 72

                // The heading that has most recently crossed the sticky-header line.
                let active = headings[0]

                for (const heading of headings) {
                    if (heading.getBoundingClientRect().top <= offset + 20) {
                        active = heading
                    } else {
                        break
                    }
                }

                tocLinks.forEach((link) => {
                    link.classList.toggle(
                        "active",
                        link.dataset.tocSlug === active?.id
                    )
                })
            }

            let ticking = false

            const onScroll = () => {
                if (!ticking) {
                    requestAnimationFrame(() => {
                        updateActiveToc()
                        ticking = false
                    })

                    ticking = true
                }
            }

            window.addEventListener("scroll", onScroll, { passive: true })
            window.addEventListener("resize", updateActiveToc)

            updateActiveToc()
        </script>

    </Fragment>
</Layout>