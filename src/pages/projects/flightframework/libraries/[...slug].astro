---
import path from "node:path"
import { fileURLToPath } from "node:url"

import { getMarkdownFiles, loadMarkdown } from "../../../../markdown.ts"
import DocsLayout from "../../../../components/docs.astro"

export function getStaticPaths() {
    const librariesDir = path.dirname(fileURLToPath(import.meta.url))

    return getMarkdownFiles(librariesDir).map((file) => ({
        params: {
            slug: file.slug,
        },
        props: {
            document: loadMarkdown(file.path),
        },
    }))
}

const { document } = Astro.props
---

<DocsLayout>
    <article class="markdown" set:html={document.html} />
</DocsLayout>