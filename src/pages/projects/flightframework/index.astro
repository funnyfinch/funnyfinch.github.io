---
import Layout from "../../../components/layout.astro";
import SubNav from "./nav.astro"

import "./style.css"

const pathName = Astro.url.pathname
const dir = "/projects/flightframework"
---

<Layout>
    <Fragment slot="body">
        <SubNav definition={[
            { label:"flight", href: dir, current: pathName===dir },
            { label:"libraries", href: `${dir}/libraries`, current: pathName.match("/libraries")!=null },
            { label:"guide", href: `${dir}/guide`, current: pathName.match("/guide")!=null }
        ]} />

        <main class="content">
            <div class="flight-hero">
                <div class="flightframework-logo">
                    
                </div>
            </div>
            
            <div style="height: 200vh" />
            <slot />
        </main>
    </Fragment>
</Layout>