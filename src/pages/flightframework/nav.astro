---
import SubNav from "../../components/sub-nav.astro"

import "./style.css"

const pathName = Astro.url.pathname.replace(/\/+$/, "") || "/";
const dir = "/flightframework"
---

<SubNav definition={[
    { label:"flight", href: dir, current: pathName===dir },
    { label:"installation", href: `${dir}/installation`, current: pathName.match("/installation")!=null },
    { label:"libraries", href: `${dir}/libraries/cleaner`, current: pathName.match("/libraries")!=null },
    { label:"guide", href: `${dir}/guide/getting-started`, current: pathName.match("/guide")!=null }
]} />