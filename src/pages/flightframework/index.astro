---
import Layout from "../../components/layout.astro";
import SubNav from "./nav.astro";
import "./style.css";

const pathName = Astro.url.pathname;
const dir = "/projects/flightframework";

const normalizedPath = pathName.replace(/\/+$/, "") || "/";
---

<Layout>
    <Fragment slot="body">
        <SubNav />

        <main class="content">
            <div class="flight-hero">
                <div class="flightframework-logo">
                </div>
            </div>
            <div style="height: 200vh" />
            <slot />
        </main>
    </Fragment>
</Layout>