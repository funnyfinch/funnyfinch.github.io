---
import Layout from "../../components/layout.astro";
import TutorialCard from "../../components/tutorial-card.astro"
import "./tutorials.css"
---

<Layout>
    <Fragment slot="body">
        <main class="content">
            <div class="tutorial-hero">
                <h2 style="justify-self: center; margin-top: 0; font-size: 3rem;">all my tutorials</h2>
            </div>
            <div class="tutorial-cards">
                <TutorialCard
                    href="/tutorials/beginner-scripting/overview/"
                    title="beginner-scripting"
                    description="introductory tutorial into Roblox Studio and scripting on Roblox with Luau"
                    tags={["ROBLOX", "INTERMEDIATE", "2026"]}
                >
                    <ul class="tutorial-covers">
                        <li>basics of Roblox Studio</li>
                        <li>variables, functions</li>
                        <li>tables</li>
                        <li>ModuleScripts</li>
                        <li>client-server architecture</li>
                        <li>RemoteEvents and RemoteFunctions</li>
                        <li>type checking</li>
                    </ul>
                </TutorialCard>
                <TutorialCard
                    href="/tutorials/beginner-scripting/overview/"
                    title="intermediate-scripting"
                    description="introductory "
                    tags={["ROBLOX", "INTERMEDIATE", "2026"]}
                >
                    <ul class="tutorial-covers">
                        <li>metatables and practical usage</li>
                    </ul>
                </TutorialCard>
            </div>
        </main>
    </Fragment>
</Layout>