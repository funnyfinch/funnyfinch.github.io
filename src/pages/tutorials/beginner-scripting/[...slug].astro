---
import DocsLayout from "../../../components/docs.astro"
import { parseMarkdown } from "../../../markdown"
import docs from "./docs.json"

interface Document {
    slug: string
    title: string
    html: string
    toc: {
        title: string
        slug: string
        depth: number
    }[]
}

export async function getStaticPaths() {
    const markdown = import.meta.glob(
        "../../content/tutorials/beginner-scripting/*.md",
        {
            eager: true,
            query: "?raw",
            import: "default",
        }
    ) as Record<string, string>

    const documents: Document[] = await Promise.all(

        docs.docs.map(async (slug) => {

            const key = Object.keys(markdown).find(
                (path) => path.endsWith(`/${slug}.md`)
            )

            if (!key) {
                throw new Error(
                    `Tutorial file not found: ${slug}.md`
                )
            }

            const markdownDocument = await parseMarkdown(
                markdown[key]
            )

            return {
                slug,
                title: slug,
                ...markdownDocument,
            }
        })
    )

    return documents.map((document) => ({
        params: {
            slug: document.slug,
        },

        props: {
            document,
            documents,
        },
    }))
}

const {
    document,
    documents
} = Astro.props

const slug = Astro.params.slug!
---

<DocsLayout
    document={document}
    documents={documents}
    currentSlug={slug}
    basePath="/tutorials/beginner-scripting"
    navTitle="beginner-scripting"
/>